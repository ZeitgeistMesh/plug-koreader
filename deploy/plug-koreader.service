[Unit]
Description=Koreader (xf mesh plug)
Requires=plug-koreader.socket
After=network-online.target nats-server.service postgresql.service plug-koreader.socket
Wants=network-online.target nats-server.service postgresql.service

[Service]
Type=simple
WorkingDirectory=/code/xf/plug-koreader
EnvironmentFile=/code/xf/.tmp/xfctl/systemd/env/common.env
EnvironmentFile=/code/xf/.tmp/xfctl/systemd/env/plug-koreader.env
ExecStart=/code/xf/plug-koreader/bin/plug-koreader
Sockets=plug-koreader.socket
User=code
Group=code
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ProtectClock=yes
LockPersonality=yes
Restart=on-failure
RestartSec=2
SyslogIdentifier=plug-koreader

[Install]
WantedBy=multi-user.target
